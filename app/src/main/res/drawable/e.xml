<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="false" android:state_pressed="false">
        <shape android:shape="oval">
            <size android:height="40.0dp" android:width="40.0dp" />
            <solid android:color="@color/ae" />
            <stroke android:width="1.0dp" android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:state_selected="false" android:state_pressed="true">
        <shape android:shape="oval">
            <size android:height="40.0dp" android:width="40.0dp" />
            <solid android:color="@color/ae" />
            <stroke android:width="1.0dp" android:color="@color/ae" />
        </shape>
    </item>
    <item android:state_selected="true" android:state_pressed="false">
        <shape android:shape="oval">
            <size android:height="40.0dp" android:width="40.0dp" />
            <solid android:color="@android:color/white" />
            <stroke android:width="1.0dp" android:color="@android:color/white" />
        </shape>
    </item>
</selector>
